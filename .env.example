# ==============================================================================
# GrantCheck — Environment Configuration Template
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database Connection URL
# For SQLite (local lightweight):
DATABASE_URL=sqlite:///./grantcheck.db
# For PostgreSQL (production / Docker Compose):
# DATABASE_URL=postgresql://grantcheck:grantcheck_secret@localhost:5432/grantcheck

# LLM Provider Configuration
# Supported options: mock (zero-dependency default benchmark), openai, gemini
LLM_PROVIDER=mock

# OpenAI Settings (required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Settings (required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# LLM Network & Resilience Settings
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3

# File Storage Directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
