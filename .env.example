# ==============================================================================
# GrantCheck — Environment Configuration Template
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database Connection URL
# For SQLite (local lightweight):
DATABASE_URL=sqlite:///./grantcheck.db

# Docker Compose PostgreSQL. Replace with a unique, URL-safe value before startup.
POSTGRES_DB=grantcheck
POSTGRES_USER=grantcheck
POSTGRES_PASSWORD=replace_with_a_unique_url_safe_password
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# LLM Provider Configuration (mock is the default and needs no API key)
# Supported options: mock (zero-dependency default benchmark), openai, gemini
LLM_PROVIDER=mock

# OpenAI Settings (required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Settings (required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# LLM Network & Resilience Settings
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3

# File Storage Directory
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
